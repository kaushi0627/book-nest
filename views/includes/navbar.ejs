<style>
  .search-btn{
    border-radius: 25px;
    background-color:  #fe424d;
    color:#fff;
    padding: 0 1.5rem 0 1.5rem;
  }
  .search-btn:hover{
    background-color:  #fe424d;
    color:#fff;
  }

  .search-btn i{
    display: inline;
    margin-right: .5rem;
  }
  .form-inp{
    border-radius: 25px;
    padding: .5rem 3rem .5rem 3rem;
    font-family: .9rem;
  }
@media (max-width: 576px) {
  .form-inp {
    width: 100%;
    padding: 0.5rem 1rem;
    margin-bottom: 0.5rem;
  }

  .search-btn {
    width: 100%;
    margin-bottom: 1rem;
  }

  .navbar-nav {
    text-align: center;
  }

  .navbar-nav .nav-link {
    padding: 0.7rem 0;
  }
}
  .navbar-collapse {
    background: white;
    padding: 1rem 0;
    z-index: 1050;
  }
</style>

<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-solid fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <div class="navbar-nav mx-auto w-100 w-md-auto">
        <div class="d-flex " role="search">
        <form action="/listings/search" method="get"
      class="d-flex flex-column flex-md-row w-100"
      role="search">
        <input class="form-control me-2 form-inp" name="country" type="search" placeholder="Search by country" aria-label="Search" required/>
        <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search </button>
        </form>
      </div>
      </div>
      
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <% if(!currUser){ %>
          <a class="nav-link signup" aria-current="page" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <%}%>
        <% if(currUser){ %>
        <a class="nav-link" href="/logout"><b>Log out</b> </a>
         <%}%>
      </div>
    </div>
  </div>
</nav>